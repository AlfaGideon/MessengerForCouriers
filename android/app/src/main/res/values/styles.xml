<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#50D2C0</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:navigationBarColor">#0A1016</item>
        <item name="android:windowBackground">#101820</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:colorAccent">#50D2C0</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:navigationBarColor">#0A1016</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
